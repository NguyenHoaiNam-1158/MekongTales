---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { anhToiUu } from '../lib/img';

const tatCa = (await getCollection('thanh-vien')).sort(
  (a, b) => a.data.thu_tu - b.data.thu_tu
);
const thanhVien = tatCa.filter((m) => !m.data.giang_vien);
const giangVien = tatCa.filter((m) => m.data.giang_vien);
---
<BaseLayout title="Về chúng tôi" mo_ta="Giới thiệu về dự án Mekong Tales và nhóm thực hiện.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Về chúng tôi</span>
      <h1>Mekong Tales</h1>
      <p>Chuyện kể từ dòng sông di sản.</p>
    </div>
  </section>

  <section class="wrap block">
    <h2 class="block-title">Giới thiệu dự án</h2>
    <p class="project">
      Mekong Tales được xây dựng nhằm ghi nhận, lưu giữ và lan tỏa những câu chuyện đời
      thực tại khu vực sông Tiền thông qua hình thức phóng sự số. Dự án khai thác những nét
      đẹp văn hóa truyền thống, tập tục địa phương, câu chuyện truyền cảm hứng của người dân
      và các mô hình thích ứng hiệu quả trước biến đổi khí hậu để phát triển kinh tế địa
      phương. Thông qua việc ứng dụng công nghệ số và các nền tảng truyền thông hiện đại, dự
      án hướng đến xây dựng một kho tư liệu số về văn hóa và con người vùng sông Tiền, góp
      phần kết nối thế hệ trẻ với quê hương, quảng bá hình ảnh miền Tây Nam Bộ và lan tỏa
      những giá trị phát triển bền vững đến cộng đồng.
    </p>
  </section>

  <section class="wrap block">
    <h2 class="block-title">Nhóm thực hiện</h2>
    {thanhVien.length === 0 ? (
      <p class="empty">
        Chưa có thành viên nào. Thêm file <code>.md</code> vào
        <code>src/content/thanh-vien/</code> để hiện ở đây.
      </p>
    ) : (
      <div class="team">
        {thanhVien.map((tv) => (
          <div class="member">
            {tv.data.anh ? (
              <img src={anhToiUu(tv.data.anh, { w: 400 })} alt={tv.data.title} loading="lazy" />
            ) : (
              <div class="avatar-placeholder"></div>
            )}
            <h3>{tv.data.title}</h3>
            <p class="role">{tv.data.vai_tro}</p>
          </div>
        ))}
      </div>
    )}
  </section>

  {giangVien.length > 0 && (
    <section class="wrap block">
      <h2 class="block-title">Giảng viên hướng dẫn</h2>
      {giangVien.map((gv) => (
        <div class="advisor">
          <div class="advisor-photo">
            {gv.data.anh ? (
              <img src={anhToiUu(gv.data.anh, { w: 700 })} alt={gv.data.title} loading="lazy" />
            ) : (
              <div class="advisor-placeholder"></div>
            )}
          </div>
          <div class="advisor-info">
            <h3>{gv.data.title}</h3>
            <p class="advisor-role">{gv.data.vai_tro}</p>
          </div>
        </div>
      ))}
    </section>
  )}
</BaseLayout>

<style>
  .page-head {
    background: var(--river);
    color: var(--paper);
    padding: 56px 0;
  }
  .page-head h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 8px 0 10px; }
  .page-head p { color: #e6e0d2; margin: 0; }

  .block { margin-top: 56px; }
  .block-title {
    font-size: 1.7rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
    margin-bottom: 24px;
  }
  .project { max-width: 820px; color: var(--ink-soft); }

  .team {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 28px;
  }
  .member { text-align: center; }
  .member img, .avatar-placeholder {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 14px;
    background: var(--paper-2);
  }
  .member h3 { font-size: 1.1rem; margin: 0 0 2px; }
  .role { color: var(--ink-soft); font-size: 0.92rem; margin: 0; }

  .empty {
    color: var(--ink-soft);
    background: var(--paper-2);
    padding: 24px;
    border-radius: 10px;
  }

  /* Giảng viên hướng dẫn */
  .advisor {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
    align-items: top;
    margin-bottom: 32px;
  }
  .advisor-photo img,
  .advisor-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 12px;
    background: var(--paper-2);
  }
  .advisor-info h3 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--river);
    margin: 0 0 10px;
  }
  .advisor-role { color: var(--ink-soft); margin: 0; font-size: 1.05rem; }
  @media (max-width: 720px) {
    .advisor { grid-template-columns: 1fr; gap: 20px; }
    .advisor-photo { max-width: 280px; }
  }
  code {
    background: rgba(15, 76, 71, 0.1);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>