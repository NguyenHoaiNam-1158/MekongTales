---
import { getCollection } from 'astro:content';
import { CAC_TINH, timTinhTheoSlug } from '../lib/tinhThanh';

// Gom bài viết theo tỉnh. `tinh_slug` trong bài có thể là tên tỉnh cũ
// (trước sáp nhập 2025) nên phải tra qua timTinhTheoSlug.
const bai = (await getCollection('bai-viet')).filter((b) => !b.data.draft);
const baiTheoTinh: Record<string, { tieu_de: string; url: string; chuyen_muc: string }[]> = {};

for (const b of bai) {
  const slug = b.data.dia_diem?.tinh_slug;
  if (!slug) continue;

  const tinh = timTinhTheoSlug(slug);
  if (!tinh) {
    console.warn(`[ban-do] Bài "${b.id}" có tinh_slug="${slug}" không khớp tỉnh nào. Bỏ qua.`);
    continue;
  }

  (baiTheoTinh[tinh.slug] ??= []).push({
    tieu_de: b.data.title,
    url: `/bai-viet/${b.id}`,
    chuyen_muc: b.data.chuyen_muc,
  });
}

const duLieuTinh = CAC_TINH.map((t) => ({ ...t, bai: baiTheoTinh[t.slug] ?? [] }));
---

<div class="bd-boc">
  <div class="bd-map-wrap">
    <div id="bd-tinh" role="application" aria-label="Bản đồ tỉnh thành Đồng bằng sông Cửu Long"></div>
    <p class="bd-ghi-chu">
      Bản đồ theo địa giới sau sáp nhập 2025 — 13 tỉnh miền Tây cũ nay còn 5 tỉnh thành.
      Chạm vào một tỉnh để xem thông tin.
    </p>
  </div>

  <aside class="bd-panel" data-panel aria-live="polite">
    <div class="bd-panel-rong" data-rong>
      <p>Chạm vào một tỉnh trên bản đồ để xem đặc sản, di tích và các bài viết liên quan.</p>
    </div>
    <div class="bd-panel-noi-dung" data-noi-dung hidden></div>
  </aside>
</div>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<script define:vars={{ duLieuTinh }}>
  const CM = { 'ki-uc': 'Kí ức', 'am-thuc': 'Ẩm thực', 'lang-nghe': 'Làng nghề', 'lich-su': 'Lịch sử' };

  function napLeaflet() {
    return new Promise((res, rej) => {
      if (window.L) return res(window.L);
      const s = document.createElement('script');
      s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      s.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
      s.crossOrigin = '';
      s.onload = () => res(window.L);
      s.onerror = rej;
      document.head.appendChild(s);
    });
  }

  const thoat = (t) =>
    String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

  // GeoJSON do scripts/rut-gon-ban-do.mjs sinh ra luôn có `ma`; tra theo mã cho
  // chắc vì file bản đồ gốc từng gán nhầm tên tỉnh. Tra theo tên chỉ là dự phòng.
  function timTinh(props) {
    return (
      duLieuTinh.find((t) => t.ma === props.ma) ??
      duLieuTinh.find((t) => t.ten === (props.ten ?? props.TinhThanh))
    );
  }

  const elRong = document.querySelector('[data-rong]');
  const elNoiDung = document.querySelector('[data-noi-dung]');
  const elPanel = document.querySelector('[data-panel]');

  function danhSach(muc) {
    return muc.map((d) => `<li>${thoat(d)}</li>`).join('');
  }

  function hienPanel(tinh) {
    if (!tinh) return;

    const bai = tinh.bai.length
      ? tinh.bai
          .map(
            (b) =>
              `<a class="bd-bai" href="${thoat(b.url)}"><span>${thoat(CM[b.chuyen_muc] || '')}</span>${thoat(b.tieu_de)}</a>`
          )
          .join('')
      : '<p class="bd-chua">Chưa có bài viết về tỉnh này.</p>';

    elNoiDung.innerHTML = `
      <button type="button" class="bd-dong" data-dong aria-label="Đóng, bỏ chọn tỉnh">&times;</button>
      <h2>${thoat(tinh.ten)}</h2>
      <p class="bd-gop">Gồm ${tinh.sap_nhap.map((t) => `<span>${thoat(t)}</span>`).join('')} (trước sáp nhập)</p>
      <p class="bd-gt">${thoat(tinh.gioi_thieu)}</p>
      <h3>Đặc sản</h3><ul class="bd-ds">${danhSach(tinh.dac_san)}</ul>
      <h3>Di tích tiêu biểu</h3><ul class="bd-dt">${danhSach(tinh.di_tich)}</ul>
      <h3>Bài viết liên quan</h3><div class="bd-ds-bai">${bai}</div>
    `;

    elRong.hidden = true;
    elNoiDung.hidden = false;
    elPanel.scrollTop = 0;

    // Trên màn hình hẹp panel nằm dưới bản đồ, kéo tới cho người dùng thấy.
    if (window.matchMedia('(max-width: 860px)').matches) {
      elPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function xoaPanel() {
    elNoiDung.hidden = true;
    elNoiDung.innerHTML = '';
    elRong.hidden = false;
  }

  napLeaflet().then(async (L) => {
    const map = L.map('bd-tinh', { scrollWheelZoom: false, zoomControl: true }).setView([9.9, 105.8], 7);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap',
      maxZoom: 12,
    }).addTo(map);

    let geo;
    try {
      const res = await fetch('/data/dbscl.geojson');
      if (!res.ok) throw new Error(String(res.status));
      geo = await res.json();
    } catch {
      elRong.innerHTML =
        '<p style="color:#8c3a28">Chưa tải được dữ liệu bản đồ. Kiểm tra file public/data/dbscl.geojson đã có chưa.</p>';
      return;
    }

    const mauThuong = { fillColor: '#2f5d50', fillOpacity: 0.25, color: '#2f5d50', weight: 1 };
    const mauRe = { fillColor: '#2f5d50', fillOpacity: 0.42, color: '#2f5d50', weight: 1 };
    const mauChon = { fillColor: '#e0a13a', fillOpacity: 0.55, color: '#c8791f', weight: 2 };

    let dangChon = null;
    let toanBo = null;

    function chon(lyr, tinh) {
      if (dangChon === lyr) return;
      if (dangChon) dangChon.setStyle(mauThuong);
      lyr.setStyle(mauChon);
      lyr.bringToFront();
      dangChon = lyr;
      map.fitBounds(lyr.getBounds(), { padding: [30, 30] });
      hienPanel(tinh);
    }

    function boChon() {
      if (dangChon) dangChon.setStyle(mauThuong);
      dangChon = null;
      xoaPanel();
      if (toanBo) map.fitBounds(toanBo, { padding: [10, 10] });
    }

    const layer = L.geoJSON(geo, {
      style: mauThuong,
      onEachFeature: (feature, lyr) => {
        const tinh = timTinh(feature.properties);
        if (!tinh) {
          console.warn('[ban-do] Không có dữ liệu cho tỉnh trong GeoJSON:', feature.properties);
          return;
        }

        lyr.bindTooltip(tinh.ten, { sticky: true });

        lyr.on({
          mouseover: () => { if (lyr !== dangChon) lyr.setStyle(mauRe); },
          mouseout: () => { if (lyr !== dangChon) lyr.setStyle(mauThuong); },
          click: () => chon(lyr, tinh),
          // Cho phép chọn tỉnh bằng bàn phím.
          add: () => {
            const el = lyr.getElement?.();
            if (!el) return;
            el.setAttribute('tabindex', '0');
            el.setAttribute('role', 'button');
            el.setAttribute('aria-label', `Xem thông tin tỉnh ${tinh.ten}`);
            el.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                chon(lyr, tinh);
              }
            });
          },
        });
      },
    }).addTo(map);

    toanBo = layer.getBounds();
    map.fitBounds(toanBo, { padding: [10, 10] });

    elPanel.addEventListener('click', (e) => {
      if (e.target.closest('[data-dong]')) boChon();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dangChon) boChon();
    });
  });
</script>

<style>
  .bd-boc {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
    max-width: var(--wrap);
    margin: 0 auto;
  }
  @media (max-width: 860px) {
    .bd-boc { grid-template-columns: 1fr; }
  }

  #bd-tinh {
    height: 520px;
    border-radius: 12px;
    border: 1px solid var(--line);
    z-index: 1;
  }
  @media (max-width: 640px) { #bd-tinh { height: 380px; } }

  #bd-tinh :global(path:focus-visible) { outline: 2px solid var(--marigold); outline-offset: 2px; }

  .bd-ghi-chu { margin-top: 10px; font-size: 0.85rem; color: var(--ink-soft); }

  .bd-panel {
    position: relative;
    background: var(--paper-2, #f5f0e4);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
    max-height: 560px;
    overflow-y: auto;
  }
  .bd-panel-rong p { color: var(--ink-soft); line-height: 1.6; }

  .bd-panel :global(.bd-dong) {
    position: absolute; top: 12px; right: 12px;
    width: 30px; height: 30px; line-height: 1;
    border: 1px solid var(--line); border-radius: 50%;
    background: var(--paper); color: var(--ink-soft);
    font-size: 1.2rem; cursor: pointer;
  }
  .bd-panel :global(.bd-dong:hover) { color: var(--ink); border-color: var(--river); }

  .bd-panel :global(h2) { margin: 0 40px 6px 0; color: var(--river); font-size: 1.5rem; }
  .bd-panel :global(.bd-gop) {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
    margin: 0 0 14px; font-size: 0.78rem; color: var(--ink-soft);
  }
  .bd-panel :global(.bd-gop span) {
    background: var(--paper); border: 1px solid var(--line); border-radius: 999px;
    padding: 2px 9px; color: var(--ink);
  }
  .bd-panel :global(.bd-gt) { color: var(--ink-soft); line-height: 1.6; margin: 0 0 16px; }
  .bd-panel :global(h3) {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--marigold); margin: 16px 0 8px;
  }
  .bd-panel :global(ul) { margin: 0; padding-left: 18px; line-height: 1.7; }
  .bd-panel :global(.bd-ds-bai) { display: flex; flex-direction: column; gap: 8px; }
  .bd-panel :global(.bd-bai) {
    display: block; padding: 10px 12px; background: var(--paper);
    border: 1px solid var(--line); border-radius: 8px; color: var(--ink);
    text-decoration: none; font-size: 0.92rem; line-height: 1.4;
  }
  .bd-panel :global(.bd-bai:hover) { border-color: var(--river); }
  .bd-panel :global(.bd-bai span) {
    display: block; font-size: 0.68rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--marigold); margin-bottom: 2px;
  }
  .bd-panel :global(.bd-chua) { color: var(--ink-soft); font-style: italic; font-size: 0.9rem; }
</style>
