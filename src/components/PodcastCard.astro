---
interface Props {
  title: string;
  youtube_id: string;
  mo_ta?: string;
  orientation?: 'portrait' | 'landscape';
}
const { title, youtube_id, mo_ta, orientation = 'portrait' } = Astro.props;
---
<article class:list={['pcard', orientation]}>
  <div class="embed">
    <iframe
      src={`https://www.youtube.com/embed/${youtube_id}`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
  <div class="pbody">
    <h3>{title}</h3>
    {mo_ta ? <p>{mo_ta}</p> : null}
  </div>
</article>

<style>
  .pcard {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .embed { background: #000; }
  .portrait .embed { aspect-ratio: 9 / 16; }
  .landscape .embed { aspect-ratio: 16 / 9; }
  .embed iframe { width: 100%; height: 100%; border: 0; }
  .pbody { padding: 16px 18px 20px; }
  .pbody h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.05rem;
    margin: 0;
  }
  .pbody p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin: 8px 0 0;
  }
</style>